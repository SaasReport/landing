{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/mcp-tool.schema.json",
  "title": "kit.mcp-tool.v1",
  "description": "One MCP tool as a kit MCP server lists it (tools/list): a snake_case name, a description, and an inputSchema that is itself a JSON Schema object whose properties are typed. The contract every kit MCP tool is tested against (packages/cloudflare/test/calendar.test.mjs).",
  "type": "object",
  "required": ["name", "description", "inputSchema"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)+$" },
    "title": { "type": "string" },
    "description": { "type": "string", "minLength": 10 },
    "inputSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": "object", "anyOf": [ { "required": ["type"] }, { "required": ["enum"] }, { "required": ["$ref"] }, { "required": ["anyOf"] }, { "required": ["oneOf"] } ] }
        },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outputSchema": { "type": "object" },
    "annotations": { "type": "object" }
  }
}
