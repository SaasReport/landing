{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/sim-scenario.schema.json",
  "title": "kit.sim-scenario.v1",
  "description": "One scenario for a @saasreport/sim engine: which engine, a seed, the as-of instant, where the inputs come from (synthetic, the customer's own, or computed), and the engine's inputs. A scenario plus the engine version determines the run exactly (same seed, same output).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "engine",
    "seed",
    "asOf",
    "source",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "kit.sim-scenario.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "enum": [
        "curve",
        "price-risk",
        "irrbb",
        "saccr",
        "sma",
        "lcr",
        "nsfr"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Seeds the PRNG of any generator in the run. Every run records it, even when nothing random happens."
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "description": "The instant the inputs are true for. The engines never read a clock."
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "sandbox-mock",
            "customer-dataset",
            "computed"
          ],
          "description": "Badges SYNTHETIC, YOURS, COMPUTED."
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
      "description": "Jurisdiction profile of the reference-data tables, where the engine uses tables."
    },
    "inputs": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "engine": {
            "const": "curve"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/curveInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "price-risk"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/priceRiskInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "irrbb"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/irrbbInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "saccr"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/saccrInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "sma"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/smaInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "lcr"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/lcrInputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "const": "nsfr"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "$ref": "#/$defs/nsfrInputs"
          }
        }
      }
    }
  ],
  "$defs": {
    "curveInputs": {
      "type": "object",
      "required": [
        "curve"
      ],
      "additionalProperties": false,
      "properties": {
        "curve": {
          "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/curve-input.schema.json"
        },
        "fitNss": {
          "type": "boolean",
          "description": "Also fit Nelson-Siegel-Svensson to the zero rates."
        },
        "forwardTenors": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "description": "Maturities at which to report discount factors and 1-year forward rates (default: the curve's own pillars).",
          "maxItems": 200
        }
      }
    },
    "priceRiskInputs": {
      "type": "object",
      "required": [
        "curve",
        "instruments"
      ],
      "additionalProperties": false,
      "properties": {
        "curve": {
          "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/curve-input.schema.json"
        },
        "instruments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/instrument"
          }
        },
        "bump": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 0.01,
          "description": "Parallel bump as a decimal rate (the engine's default is the package's LIMITS.defaultBump, 1 bp)."
        },
        "keyTenors": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "maxItems": 50
        }
      }
    },
    "instrument": {
      "type": "object",
      "required": [
        "id",
        "type",
        "notional",
        "dayCount",
        "startDate",
        "maturityDate",
        "valuationDate",
        "frequency"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "enum": [
            "fixed",
            "floating",
            "amortising",
            "profit-rate"
          ]
        },
        "notional": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dayCount": {
          "enum": [
            "ACT/360",
            "ACT/365F",
            "30/360"
          ]
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "maturityDate": {
          "type": "string",
          "format": "date"
        },
        "valuationDate": {
          "type": "string",
          "format": "date"
        },
        "frequency": {
          "enum": [
            1,
            2,
            4,
            12
          ]
        },
        "rate": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 1,
          "description": "fixed and amortising: the coupon rate."
        },
        "spread": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "description": "floating: spread over the projected forward."
        },
        "lastFixing": {
          "type": "number",
          "minimum": -0.1,
          "maximum": 1,
          "description": "floating: the rate fixed for the current period, when it has started."
        },
        "amortisation": {
          "enum": [
            "level",
            "linear"
          ]
        },
        "contract": {
          "enum": [
            "murabaha",
            "ijara"
          ],
          "description": "profit-rate: a fixed contractual profit schedule (pricing analogue, not a compliance statement)."
        },
        "profitRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "residualFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "ijara: the final purchase price as a share of cost."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "rate"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "floating"
              }
            }
          },
          "then": {
            "required": [
              "spread"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "amortising"
              }
            }
          },
          "then": {
            "required": [
              "rate",
              "amortisation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "profit-rate"
              }
            }
          },
          "then": {
            "required": [
              "contract",
              "profitRate"
            ]
          }
        }
      ]
    },
    "irrbbInputs": {
      "type": "object",
      "required": [
        "currency",
        "curve"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "curve": {
          "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/curve-input.schema.json"
        },
        "ladder": {
          "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/cashflow-ladder.schema.json"
        },
        "generate": {
          "type": "object",
          "required": [
            "minorExponent",
            "assets",
            "liabilities"
          ],
          "additionalProperties": false,
          "description": "Instead of a ladder: a synthetic one from the scenario's seed (badge SYNTHETIC).",
          "properties": {
            "minorExponent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "assets": {
              "$ref": "#/$defs/side"
            },
            "liabilities": {
              "$ref": "#/$defs/side"
            }
          }
        },
        "tier1": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "floor": {
          "type": "object",
          "required": [
            "startBp",
            "perYearBp"
          ],
          "additionalProperties": false,
          "properties": {
            "startBp": {
              "type": "number",
              "minimum": -1000,
              "maximum": 0
            },
            "perYearBp": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "ladder"
          ]
        },
        {
          "required": [
            "generate"
          ]
        }
      ]
    },
    "side": {
      "type": "object",
      "required": [
        "count",
        "total",
        "maxRepricingYears"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "total": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          ]
        },
        "maxRepricingYears": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "saccrInputs": {
      "type": "object",
      "required": [
        "minorExponent",
        "trades"
      ],
      "additionalProperties": false,
      "properties": {
        "minorExponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "collateral": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          ]
        },
        "margin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              ]
            },
            "mta": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              ]
            },
            "nica": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                }
              ]
            },
            "remarginingDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "cleared": {
              "type": "boolean"
            },
            "illiquidCollateral": {
              "type": "boolean",
              "description": "CRE52.50: the margin period of risk is doubled in this situation; doubling is not implemented, so true is refused."
            },
            "hardToReplaceTrades": {
              "type": "boolean",
              "description": "CRE52.50: the margin period of risk is doubled in this situation; doubling is not implemented, so true is refused."
            },
            "recentDisputes": {
              "type": "boolean",
              "description": "CRE52.50: the margin period of risk is doubled in this situation; doubling is not implemented, so true is refused."
            }
          }
        },
        "trades": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": [
              "assetClass",
              "notional",
              "maturityYears"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "assetClass": {
                "enum": [
                  "ir",
                  "fx",
                  "credit",
                  "equity",
                  "commodity"
                ]
              },
              "mtm": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+$"
                  }
                ]
              },
              "notional": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "position": {
                "enum": [
                  "long",
                  "short"
                ]
              },
              "maturityYears": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "startYears": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "endYears": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "currencyPair": {
                "type": "string",
                "minLength": 3
              },
              "subclass": {
                "type": "string",
                "minLength": 1
              },
              "referenceId": {
                "type": "string",
                "minLength": 1
              },
              "hedgingSet": {
                "enum": [
                  "energy",
                  "metals",
                  "agricultural",
                  "other"
                ]
              },
              "basis": {
                "type": "boolean"
              },
              "volatility": {
                "type": "boolean"
              },
              "cdoTranche": {
                "type": "boolean"
              },
              "option": {
                "type": "object",
                "required": [
                  "kind",
                  "position",
                  "underlying",
                  "strike",
                  "expiryYears"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "call",
                      "put"
                    ]
                  },
                  "position": {
                    "enum": [
                      "bought",
                      "sold"
                    ]
                  },
                  "underlying": {
                    "type": "number"
                  },
                  "strike": {
                    "type": "number"
                  },
                  "expiryYears": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "shift": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "option"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "position"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "position"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "assetClass": {
                      "const": "ir"
                    }
                  }
                },
                "then": {
                  "required": [
                    "currency",
                    "startYears",
                    "endYears"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "assetClass": {
                      "const": "fx"
                    }
                  }
                },
                "then": {
                  "required": [
                    "currencyPair"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "assetClass": {
                      "const": "credit"
                    }
                  }
                },
                "then": {
                  "required": [
                    "subclass",
                    "referenceId",
                    "startYears",
                    "endYears"
                  ],
                  "properties": {
                    "subclass": {
                      "enum": [
                        "AAA",
                        "AA",
                        "A",
                        "BBB",
                        "BB",
                        "B",
                        "CCC",
                        "index-IG",
                        "index-SG"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "assetClass": {
                      "const": "equity"
                    }
                  }
                },
                "then": {
                  "required": [
                    "subclass",
                    "referenceId"
                  ],
                  "properties": {
                    "subclass": {
                      "enum": [
                        "single",
                        "index"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "assetClass": {
                      "const": "commodity"
                    }
                  }
                },
                "then": {
                  "required": [
                    "hedgingSet",
                    "referenceId"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "smaInputs": {
      "type": "object",
      "required": [
        "currency",
        "minorExponent",
        "years"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minorExponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "years": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "interestIncome",
              "interestExpense",
              "interestEarningAssets",
              "dividendIncome",
              "otherOperatingIncome",
              "otherOperatingExpense",
              "feeIncome",
              "feeExpense",
              "tradingBookPnl",
              "bankingBookPnl"
            ],
            "additionalProperties": false,
            "properties": {
              "interestIncome": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "interestExpense": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "interestEarningAssets": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "dividendIncome": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "otherOperatingIncome": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "otherOperatingExpense": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "feeIncome": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "feeExpense": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                ]
              },
              "tradingBookPnl": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+$"
                  }
                ]
              },
              "bankingBookPnl": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+$"
                  }
                ]
              }
            }
          }
        },
        "lossHistory": {
          "type": "object",
          "required": [
            "years",
            "events"
          ],
          "additionalProperties": false,
          "properties": {
            "years": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "events": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "object",
                "required": [
                  "yearIndex",
                  "amount"
                ],
                "additionalProperties": false,
                "properties": {
                  "yearIndex": {
