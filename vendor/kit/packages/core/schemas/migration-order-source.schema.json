{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/migration-order-source.schema.json",
  "title": "kit.migration-order-source.v1",
  "description": "The source of the migration order: the wrangler version and comparator that packages/core/src/migration-order.js mirrors.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "about",
    "wrangler"
  ],
  "properties": {
    "about": {
      "type": "string",
      "minLength": 20
    },
    "wrangler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "file",
        "origin",
        "functions",
        "rule"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
