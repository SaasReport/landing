{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/sim-origin.schema.json",
  "title": "kit.sim-origin.v1",
  "description": "ORIGIN.json of @saasreport/sim: the repositories that inspired the engines, their licences, what was taken (ideas, formula shapes) and what was NOT (code), and the published standards each engine is implemented from. The engines are native re-implementations: no dependency, no copied code.",
  "type": "object",
  "required": ["$schema", "name", "license", "adoption", "max_age_days", "inspirations", "standards"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "license": { "const": "Apache-2.0" },
    "adoption": { "const": "native-reimplementation" },
    "max_age_days": { "type": "integer", "minimum": 1, "maximum": 400, "description": "The oldest a readOn day may be before the inspiration must be read again (kit check staleness, registry-fact-stale; packages/sim is a registry_dirs entry). An inspiration may declare its own, shorter or longer." },
    "inspirations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repository", "license", "readOn", "tookIdeas", "notTaken"],
        "additionalProperties": false,
        "properties": {
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "license": { "type": "string", "minLength": 1 },
          "readOn": { "type": "string", "format": "date" },
          "max_age_days": { "type": "integer", "minimum": 1, "maximum": 400, "description": "This inspiration's own threshold; the top-level max_age_days otherwise." },
          "files": { "type": "array", "items": { "type": "string" } },
          "tookIdeas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "notTaken": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "knownFlaw": { "type": "string" }
        }
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "body", "url", "engines"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "sections": { "type": "array", "items": { "type": "string" } },
          "engines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    }
  }
}
