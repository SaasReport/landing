{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/site-config.schema.json",
  "title": "kit.site-config.v1",
  "description": "site.config.js (default export): an @saasreport/site project. Structure only; checkProject/defineSite add the token, locale-pack and section checks. Top-level keys are the ones the site package reads.",
  "type": "object",
  "required": [
    "name",
    "url",
    "locales",
    "tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "The display name, or one per locale code."
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^/\\s]+[^/]$"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
          },
          {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        ]
      }
    },
    "timeZone": {
      "type": "string"
    },
    "calendar": {
      "type": "object"
    },
    "namespace": {
      "type": "object",
      "required": [
        "global",
        "key"
      ],
      "additionalProperties": false,
      "properties": {
        "global": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        }
      }
    },
    "trademark": {
      "type": "object",
      "required": [
        "names"
      ],
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mark": {
          "type": "string"
        },
        "except": {
          "type": "array"
        }
      }
    },
    "tokens": {
      "type": "object"
    },
    "content": {
      "type": "object",
      "minProperties": 1
    },
    "locale": {},
    "out": {
      "type": "string"
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "src"
            ]
          }
        ]
      }
    },
    "icons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assets": {},
    "pages": {},
    "pageChrome": {
      "type": "object",
      "description": "The inner pages chrome: icons, preload, strings per locale (nav, home, footer) and cta per locale: the header call to action (default: the landing content nav.cta).",
      "properties": {
        "cta": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "pattern": "^(/|https://|#)"
                },
                "modal": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "style": {
                  "type": "string"
                },
                "class": {
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "href"
                  ]
                },
                {
                  "required": [
                    "modal"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    "preferredSource": {
      "type": "object",
      "required": [
        "placements",
        "strings"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^(?!https?:)(?!www\\.)[a-z0-9-]+(\\.[a-z0-9-]+)+$",
          "description": "The domain Google lists as the source (no scheme, no www.); default: the host of the site's url."
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "footer",
              "blog",
              "podcasts",
              "events",
              "glossary"
            ]
          }
        },
        "strings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "title",
              "text",
              "button"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "The card's heading; {name} is the site's name."
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "One sentence on what the reader gets; {name} and {domain} are filled."
              },
              "button": {
                "type": "string",
                "minLength": 1,
                "description": "The button's label."
              }
            }
          }
        }
      },
      "description": "Add to Google preferred sources: the card and its button (https://google.com/preferences/source?q=<domain>), where it goes and its words per locale (@saasreport/site src/preferred.js)."
    },
    "search": {
      "type": "object",
      "description": "What the global search is told beyond the pages: exclude, sections, facets, synonyms, registry (kit.search-config.v1, @saasreport/site schema/search-config.schema.json)."
    },
    "css": {},
    "markdown": {},
    "sitemap": {
      "type": [
        "boolean",
        "object"
      ]
    },
    "landing": {
      "type": "boolean",
      "description": "false: no landing page; the project's own page at \"/\" (a content page generated from its sources) is the home page. Default true: the landing is rendered from content.<locale>."
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "properties": {
            "landing": {
              "const": false
            }
          },
          "required": [
            "landing"
          ]
        }
      },
      "then": {
        "required": [
          "content"
        ]
      }
    }
  ]
}
