{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/vendor-manifest.schema.json",
  "title": "kit.vendor-manifest.v1",
  "description": "<path>.manifest.json next to a vendored kit snapshot: the kit commit it was taken from and every file with its size and sha256. Written by `kit vendor sync`, verified by `kit check vendor`; never edited by hand.",
  "type": "object",
  "required": [
    "$schema",
    "path",
    "source",
    "include",
    "generated_by",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "commit",
        "commit_date"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "const": "main",
          "description": "The commit is on the kit's main history."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "include": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_by": {
      "const": "kit vendor sync"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "executable": {
            "const": true
          }
        }
      }
    }
  }
}
