{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/kit-config.schema.json",
  "title": "kit.kit-config.v1",
  "description": "kit.config.js (default export, before or after defineConfig): the runtime config of a kit site. Structure only; defineConfig (@saasreport/core) adds the cross-field checks (time zones, locales, series windows). Top-level keys are exactly core's TOP_KEYS and features exactly FEATURES (test: packages/core/test/schema.test.mjs).",
  "type": "object",
  "required": [
    "site"
  ],
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$",
          "description": "The project's short prefix without the dash (docs/NAMING.md)."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^/\\s]+"
        },
        "root": {
          "type": "string",
          "pattern": "^https?://[^/\\s]+"
        },
        "host": {
          "type": "string"
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dir": {
          "enum": [
            "rtl",
            "ltr"
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "ogImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "org": {
          "type": "object",
          "properties": {
            "sameAs": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "brand": {
      "type": "object"
    },
    "calendar": {
      "type": "object"
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "voice": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tts": {
      "type": "object"
    },
    "speech": {
      "type": "object"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "topic",
              "report",
              "term"
            ]
          }
        }
      }
    },
    "shows": {
      "type": "object"
    },
    "channels": {
      "type": "object"
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "blog",
          "podcasts",
          "glossary",
          "events",
          "reactions",
          "share",
          "calendar",
          "feeds",
          "monitor",
          "llms",
          "sitemap",
          "tags"
        ]
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "monitor": {
      "type": "object",
      "properties": {
        "drill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["form"],
          "description": "The form drill (docs/FORMS.md): a synthetic, test-marked submission of `form`, then both deliveries proved in the ledger. Runs on POST /run?mode=drill, and on the first cron run of `weekday` at or after `at`, once a day.",
          "properties": {
            "form": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "The form's name in /api/forms/<form>; the drill header is signed for it." },
            "fields": { "type": "object", "description": "Synthetic values for the fields the form requires." },
            "timeoutMs": { "type": "integer", "minimum": 1 },
            "weekday": { "description": "The day of the scheduled drill: sun..sat or 0-6 (0 = Sunday). Needs `at`.", "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 6 }, { "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] }] },
            "at": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "HH:MM in the site's time zone: the earliest time of the scheduled drill's day (the series `at`)." }
          },
          "dependentRequired": { "weekday": ["at"], "at": ["weekday"] }
        }
      }
    },
    "strings": {
      "type": "object"
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "contracts": {
      "type": "object"
    },
    "sources": {
      "type": [
        "object",
        "array"
      ]
    }
  }
}
