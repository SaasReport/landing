{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/plugin-manifest.schema.json",
  "title": "kit.plugin-manifest.v1",
  "description": "plugins/<prefix>/.claude-plugin/plugin.json: an agent plugin built with @saasreport/plugins. The name is the project's short prefix; metadata.kit names the output directory and the compile-report schema (kit.compile-report.v1). validatePlugin adds the skill and runtime checks.",
  "type": "object",
  "required": ["name", "version", "description", "license", "metadata"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "displayName": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 20 },
    "author": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "email": { "type": "string", "format": "email" } } },
    "license": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "metadata": {
      "type": "object",
      "required": ["kit"],
      "properties": {
        "kit": {
          "type": "object",
          "required": ["prefix", "outputDir", "reportSchema"],
          "properties": {
            "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
            "outputDir": { "type": "string", "pattern": "^[a-z][a-z0-9]*-out$" },
            "reportSchema": { "const": "kit.compile-report.v1" },
            "backend": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } } }
          }
        }
      }
    }
  }
}
