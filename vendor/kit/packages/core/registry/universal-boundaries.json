{
  "$schema": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/universal-boundaries.schema.json",
  "schema": "kit.universal-boundaries.v1",
  "description": "T=0 canonical cross-project boundary registry. A category is a supported envelope kind, NOT proof that any project has integrated it.",
  "phases": [
    "declare",
    "contract-validate",
    "source-verify",
    "policy-gate",
    "sandbox-execute",
    "observe",
    "independent-review",
    "production-promote",
    "live-reconcile"
  ],
  "levels": [
    {
      "id": "experience",
      "description": "Human-facing interfaces and workspaces"
    },
    {
      "id": "identity",
      "description": "Tenants and the stakeholders that own obligations"
    },
    {
      "id": "commerce",
      "description": "Customer products, entitlements and subscriptions"
    },
    {
      "id": "interface",
      "description": "Wire and developer interfaces, event delivery and notifications"
    },
    {
      "id": "execution",
      "description": "Agents, engines, routines, daemons and durable execution rails"
    },
    {
      "id": "data",
      "description": "Catalogued stores, datasets, records and knowledge"
    },
    {
      "id": "media",
      "description": "Content derivations and channel-native publications"
    },
    {
      "id": "governance",
      "description": "Contract, registry, policy, provenance, consent and evidence"
    },
    {
      "id": "infrastructure",
      "description": "Isolated runtime and Cloudflare environment boundaries"
    },
    {
      "id": "release",
      "description": "Schema migration, promotion, deployment and live attestation"
    }
