{
  "name": "@saasreport/core",
  "version": "0.1.0",
  "description": "Pure building blocks of a kit publishing site: config validation, content contracts, planner, calendar reports, agenda, markdown, SEO, feeds, calendar links, i18n, multi-locale sites and series tooling (review gate, citations).",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./config": "./src/config.js",
    "./colour": "./src/colour.js",
    "./d1-limits": "./src/d1-limits.js",
    "./migration-order": "./src/migration-order.js",
    "./form-deliveries": "./src/form-deliveries.js",
    "./planner": "./src/planner.js",
    "./contracts": "./src/contracts.js",
    "./reports": "./src/reports.js",
    "./agenda": "./src/agenda.js",
    "./markdown": "./src/markdown.js",
    "./seo": "./src/seo.js",
    "./feeds": "./src/feeds.js",
    "./calendar-links": "./src/calendar-links.js",
    "./i18n": "./src/i18n.js",
    "./dates": "./src/dates.js",
    "./ids": "./src/ids.js",
    "./locales": "./src/locales.js",
    "./series": "./src/series.js",
    "./citations": "./src/citations.js",
    "./concepts": "./src/concepts.js",
    "./ledger": "./src/ledger.js",
    "./approvals": "./src/approvals.js",
    "./trust": "./src/trust.js",
    "./verifier": "./src/verifier.js",
    "./verdict": "./src/verdict.js",
    "./scope": "./src/scope.js",
    "./witness": "./src/witness.js",
    "./ed25519": "./src/ed25519.js",
    "./canonical": "./src/canonical.js",
    "./sha256": "./src/sha256.js",
    "./schema": "./src/schema.js",
    "./safe-fetch": "./src/safe-fetch.js",
    "./podcast-provenance": "./src/podcast-provenance.js",
    "./tags": "./src/tags.js",
    "./spelling": "./src/spelling.js",
    "./podcast-provenance-sql": "./src/podcast-provenance-sql.js",
    "./schemas/*": "./schemas/*",
    "./registry/*": "./registry/*",
    "./package.json": "./package.json",
    "./media": "./src/media.js",
    "./schemas/media-bundle.schema.json": "./schemas/media-bundle.schema.json",
    "./media-render": "./src/media-render.js",
    "./universal-envelope": "./src/universal-envelope.js",
    "./schemas/universal-envelope.schema.json": "./schemas/universal-envelope.schema.json",
    "./schemas/universal-boundaries.schema.json": "./schemas/universal-boundaries.schema.json",
    "./registry/universal-boundaries.json": "./registry/universal-boundaries.json",
    "./universal-media": "./src/universal-media.js",
    "./universal-boot": "./src/universal-boot.js"
  },
  "dependencies": {
    "@saasreport/format": "*",
    "@saasreport/calendar": "*",
    "@saasreport/speech": "*"
  },
  "files": [
    "src",
    "schemas",
    "registry",
    "README.md"
  ],
  "engines": {
    "node": ">=20.17.0"
  },
  "license": "Apache-2.0",
  "sideEffects": false
}
