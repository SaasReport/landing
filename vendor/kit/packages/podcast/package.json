{
  "name": "@saasreport/podcast",
  "version": "0.1.0",
  "description": "Two-host podcast episodes on Cloudflare: scripts from content items, multi-speaker TTS (Gemini, Piper, Gradio), MP3 assembly with ID3 tags, and a durable Workflow that publishes to R2 + D1.",
