{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kit:schema:workbench-commands:v1",
  "title": "Workbench command registry (kit.workbench-commands.v1)",
  "description": "The command grammar is `VERB [target] [args]`: the first word is a verb or one of its aliases (Latin or Persian, folded: ي/ی, ك/ک, ZWNJ, digits), the second is the target (the command's first argument), the rest are `name=value` pairs. Every command opens one pane and names the data source it reads.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/command" },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
        "type": { "enum": ["string", "number", "integer", "date", "enum", "boolean"] },
        "required": { "type": "boolean" },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": ["string", "number"] } },
        "default": { "type": ["string", "number", "boolean"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "hint": { "$ref": "#/$defs/text" },
        "paneParam": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,23}$", "description": "The pane parameter this argument sets (default: the argument's name)." }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verb", "aliases", "summary", "args", "opens", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,47}$" },
        "verb": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$", "description": "The mnemonic, 2 to 8 capitals." },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 40 }, "description": "Words that also run the command, in Persian and English." },
        "summary": { "$ref": "#/$defs/text" },
        "args": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/arg" } },
        "opens": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,47}$", "description": "The id of the pane the command opens." },
        "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$", "description": "The id of the source contract the pane reads (a SourceEnvelope source)." },
        "example": { "type": "string" }
      }
    }
  }
}
