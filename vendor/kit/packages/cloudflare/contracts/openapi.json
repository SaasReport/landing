  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {},
          "field": {
            "type": "string"
          }
        }
      },
      "RsvpRequest": {
        "type": "object",
        "required": [
          "event",
          "name",
          "email",
          "consent"
        ],
        "properties": {
          "event": {
            "type": "string",
            "maxLength": 90,
            "description": "The event slug."
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 200
          },
          "company": {
            "type": "string",
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "maxLength": 120
          },
          "consent": {
            "const": true
          },
          "website": {
            "type": "string",
            "description": "Honeypot: any value is answered as accepted and stored nowhere."
          },
          "test": {
            "const": true,
            "description": "A drill: accepted only with the signed header x-kit-form-drill, once; the receipt goes to the owner and both subjects are marked TEST."
          }
        }
      },
      "RsvpAccepted": {
        "type": "object",
        "required": [
          "ok",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": true
          },
          "reference": {
            "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json#/$defs/reference"
          },
          "email_status": {
            "enum": [
              "pending",
              "sent",
              "suppressed",
              "failed"
            ],
            "description": "The receipt's status; `failed` is still a 200: the submission is recorded and the owner is told (docs/FORMS.md)."
          },
          "recorded": {
            "const": true,
            "description": "A ledger row exists for the reference. The honeypot answer carries neither email_status nor recorded."
          },
          "outcome_recorded": {
            "const": false,
            "description": "Present only when the engine's final status write failed after the row existed: the submission is recorded (do not submit again); its row stays pending and the monitor counts it."
          }
        }
      },
      "RsvpNotRecorded": {
        "type": "object",
        "required": [
          "ok",
          "error",
          "reference"
        ],
        "additionalProperties": false,
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "const": "not_recorded"
          },
          "reference": {
            "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json#/$defs/reference"
          }
        }
      },
      "Tag": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "description",
          "group",
          "group_label",
          "colour",
          "counts",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string"
          },
          "group_label": {
            "type": "string"
          },
          "colour": {
            "enum": [
              "chart1",
              "chart2",
              "chart3",
              "chart4",
              "chart5",
              "chart6",
              "accent",
              "ok",
              "warn",
              "err"
            ],
            "description": "The colour role (a tone of the project's tokens); the page paints it, a client never needs a colour value."
          },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "podcasts",
              "posts"
            ],
            "properties": {
              "podcasts": {
                "type": "integer",
                "minimum": 0
              },
              "posts": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "TagGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "TagIndex": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "groups",
          "tags"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagGroup"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          }
        }
      },
      "TagItem": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "summary",
          "published_at",
          "url",
          "tags"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "show": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TagDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "tag",
          "podcasts",
          "posts"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "tag": {
            "$ref": "#/components/schemas/Tag"
          },
          "podcasts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagItem"
            }
          },
          "posts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagItem"
            }
          }
        }
      }
    }
  }
}
