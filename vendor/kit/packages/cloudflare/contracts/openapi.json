    },
    "/api/forms/event-rsvp": {
      "post": {
        "operationId": "eventRsvp",
        "summary": "RSVP to a scheduled event (config.events.rsvp)",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Accepted and recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsvpAccepted"
                }
              }
            }
          },
          "400": {
            "description": "The body is not a JSON object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden_origin, or drill_not_signed (a `test` without a valid, unused signed header)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "length_required: the body is read bounded, so its length is declared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "The body is too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "bad_content_type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "consent_required, missing_field, invalid_email, invalid_field or event_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "not_recorded: no ledger row exists for the submission, so nothing is accepted and the visitor can write again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RsvpNotRecorded"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RsvpRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "x-kit-form-drill",
            "in": "header",
            "required": false,
            "description": "<unix ms>.<hmac-sha256(FORMS_DRILL_KEY, \"<ms>.event-rsvp\")>, valid five minutes and once: required when the body carries `test`, signed by the monitor. Without it `test` is refused (403 drill_not_signed).",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,16}\\.[0-9a-f]{64}$"
            }
          }
        ]
      }
    },
    "/api/forms/deliveries": {
      "get": {
        "operationId": "formDeliveries",
        "summary": "The form-delivery ledger over the last 24 hours: submissions, owner notifications sent, failed and pending past 15 minutes (kit.form-notification.v1 summary; docs/FORMS.md). 503 when an owner delivery failed or is stale, so the monitor's form-deliveries journey fails.",
        "tags": [
          "forms"
        ],
        "responses": {
          "200": {
            "description": "Every owner delivery in the window went",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json#/$defs/summary"
                }
              }
            }
          },
          "503": {
            "description": "An owner delivery failed or is pending past its window (the summary), or the ledger cannot be read (the error envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json#/$defs/summary"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/forms/deliveries/{reference}": {
      "get": {
        "operationId": "formDelivery",
        "summary": "One submission's two deliveries, the receipt and the owner's notification (kit.form-notification.v1): the ledger link in the owner's notification. Statuses only, no address.",
        "tags": [
          "forms"
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json#/$defs/reference"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/form-notification.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: the lookup of references is limited per client",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/forms/{form}": {
      "parameters": [
