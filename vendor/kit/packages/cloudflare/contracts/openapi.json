{
  "openapi": "3.1.0",
  "info": {
    "title": "kit Worker HTTP API (@saasreport/cloudflare)",
    "version": "1.0.0",
    "description": "The contract of every HTTP route the kit's Worker serves under /api and /mcp. Routes are switched on by config.features; a project's own routes live in that project's contract. `kit check contracts` keeps this file and the route literals in packages/cloudflare/src in step, both ways (docs/CONSTITUTION.md §1)."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Health derived from the site's monitor (kit.health.v1): ok only while the monitor reads passing",
        "description": "Read from the monitor Worker's GET /status over the MONITOR service binding (bounded). Never a constant: 200 with ok true only when the latest run is passing and not stale; 503 with the monitor's state (failing, stale, unknown, unreachable, not-bound) and the names of the failed journeys otherwise. Contract: packages/core/schemas/health.schema.json.",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "The monitor reads passing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/health.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Not healthy: the monitor reads anything but passing, or cannot be read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/health.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/build": {
      "get": {
        "operationId": "build",
        "summary": "The commit this Worker was deployed from, and the Workers behind its service bindings (kit.build.v1)",
        "description": "Served by every Worker a kit project deploys (withBuild, @saasreport/cloudflare/build). The commit is the Worker version's BUILD_COMMIT (wrangler deploy --var BUILD_COMMIT:<sha>, kit release ship); null when the version carries none (a drift); \"unreachable\" for a Worker behind a binding that did not answer. Read with no credential by kit release verify and the daily drift workflow. Contract: packages/core/schemas/build.schema.json.",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "The build",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/build.schema.json"
                }
              }
            }
          },
          "405": {
            "description": "Only GET"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "monitorStatus",
        "summary": "Monitor status (features.monitor)",
        "description": "The monitor Worker's own GET /status (kit.monitor-status.v1, packages/monitor/contracts/status.schema.json), reached through the MONITOR service binding; the site never binds the monitor's D1. 503 with a reason code when the binding is missing or the monitor does not answer.",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "The monitor's status document (kit.monitor-status.v1).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "status",
                    "last",
                    "recent",
                    "routes"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "status": {
                      "enum": [
                        "passing",
                        "failing",
                        "stale",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "No monitor to ask: never a guess.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "status": {
                      "const": "unknown"
                    },
                    "reason": {
                      "enum": [
                        "not-configured",
                        "timeout",
                        "unreachable",
                        "failed"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "operationId": "meta",
        "summary": "Forms and public APIs of the site (kit.api-meta.v1)",
        "tags": [
          "discovery"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://github.com/SaasReport/kit/blob/main/packages/cloudflare/contracts/api-meta.schema.json"
                }
              }
            }
          },
          "405": {
            "description": "Error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/blog/posts": {
      "get": {
        "operationId": "blogPosts",
        "summary": "Published posts (?kind=&tag=&q=&limit=&offset=); each post carries tags (ids) and, with a tag vocabulary, tag_labels",
        "tags": [
          "blog"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "description": "A tag id of the project's vocabulary; repeat it (tag=a&tag=b) to require several (an item needs all of them). At most 8 are used, the rest are ignored.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 48,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search words: every word must occur in the title, the summary or a tag label (letter variants and ZWNJ folded).",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ]
      }
    },
    "/api/events": {
      "get": {
        "operationId": "events",
        "summary": "Events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
