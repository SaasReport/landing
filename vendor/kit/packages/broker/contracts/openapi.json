    "/broker/v1/merge": {
      "post": {
        "operationId": "brokerMerge",
        "summary": "The broker merges a pull request pinned to its reviewed head",
        "tags": [
          "broker"
        ],
        "requestBody": {
          "required": true,
          "description": "A signed request (kit.broker-request.v1), at most 8192 bytes, with Content-Length.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/broker-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Merged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "merged",
                    "evidence"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "merged": {
                      "const": true
                    },
                    "sha": {
                      "type": "string",
                      "description": "The merge commit when it is known (GitHub's reply, or the merged pull request read back); when it is not, warning is merged_unverified."
                    },
                    "evidence": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "warning": {
                      "enum": [
                        "merged_wrong_base",
                        "merged_unverified"
                      ],
                      "description": "The merge happened, but not into the reviewed base (merged_wrong_base), or the merged pull request, its base or its merge commit could not be confirmed afterwards (merged_unverified). Recorded as evidence; act on it."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Refused (reason code, never prose)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "error"
                  ],
                  "properties": {
                    "ok": {
                      "const": false
                    },
                    "error": {
