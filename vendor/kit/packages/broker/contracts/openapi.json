            }
          },
          "502": {
            "description": "Upstream failure. merge_outcome_unknown: GitHub's merge reply was lost or unclear and the pull request was still unmerged or unreadable after polling; recorded once as an allow with that reason, never as a deny. Check the pull request.",
            "content": {
              "application/json": {
