{
  "openapi": "3.1.0",
  "info": { "title": "Fixture API", "version": "1.2.0" },
  "servers": [{ "url": "https://api.example.test" }],
  "paths": {
    "/api/health": {
      "get": { "operationId": "health", "tags": ["ops"], "summary": "Liveness", "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } } }
    },
    "/api/items/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "operationId": "getItem", "tags": ["items"], "summary": "One item",
        "parameters": [{ "name": "expand", "in": "query", "schema": { "type": "boolean" } }],
        "responses": { "200": { "description": "the item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "404": { "description": "none" } }
      },
      "put": {
        "operationId": "putItem", "tags": ["items"], "summary": "Replace an item",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } },
        "responses": { "204": { "description": "replaced" } }
      }
    },
    "/api/feed.ics": {
      "get": { "operationId": "feed", "tags": ["items"], "summary": "Calendar feed", "parameters": [{ "name": "count", "in": "query", "schema": { "type": "integer" } }], "responses": { "200": { "description": "feed", "content": { "text/calendar": { "schema": { "type": "string" } } } } } }
    }
  },
  "components": {
    "schemas": {
      "Health": { "type": "object", "required": ["ok"], "properties": { "ok": { "const": true } } },
      "Item": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "kind": { "enum": ["a", "b"] }, "parent": { "oneOf": [{ "$ref": "#/components/schemas/Item" }, { "type": "null" }] } } }
    }
  }
}
