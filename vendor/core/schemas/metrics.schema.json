{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasreport.ai/schemas/metrics.schema.json",
  "title": "saasreport.metrics.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registry",
    "version",
    "metrics"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "const": "saasreport.metrics"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "unit",
          "computation",
          "inputs",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "metric id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "money_minor",
              "ratio_bp",
              "count"
            ]
          },
          "computation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "name of the pure function in src/metrics/index.js"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
