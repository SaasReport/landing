{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasreport.ai/schemas/legal.schema.json",
  "title": "saasreport.legal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "registry",
    "version",
    "documents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry": {
      "const": "saasreport.legal"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "note": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "file",
          "audience",
          "status",
          "effective_date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "^legal/[a-z0-9-]+\\.md$"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "approved"
            ]
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
