        "cfo",
        "board",
        "investors"
      ],
      "sections": [
        {
          "id": "position",
          "title": "Where we stand",
          "metrics": [
            "mrr",
            "arr"
          ]
        },
        {
          "id": "movement",
          "title": "How revenue moved",
          "metrics": [
            "new_mrr",
            "reactivation_mrr",
            "expansion_mrr",
            "contraction_mrr",
            "churned_mrr",
            "net_new_mrr"
          ]
        },
        {
          "id": "retention",
          "title": "How much we kept",
          "metrics": [
            "nrr",
            "grr"
          ]
        }
      ]
    },
