{
  "openapi": "3.1.0",
  "info": {
    "title": "SaasReport landing forms",
    "version": "1.0.0",
    "description": "The landing's declared forms on Cloudflare Pages. A request is stored; no email is sent until the comms engine is deployed (docs/FORMS.md)."
  },
  "x-limits": {
    "maxBodyBytes": 16384,
    "maxPerHour": 120
  },
  "paths": {
    "/api/forms/{id}": {
      "post": {
        "operationId": "submitForm",
        "summary": "Send a declared form",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "early-access"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/early-access"
                  }
                ]
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok",
                    "reference"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "reference": {
                      "type": "string",
                      "pattern": "^SR-[0-9]{8}-[0-9A-F]{8}$"
                    }
                  }
                }
              }
            }
          },
          "303": {
            "description": "Stored (a form post without script): back to the page",
            "headers": {
              "location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "405": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "early-access": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "company",
          "role",
          "consent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "format": "email"
          },
          "company": {
            "type": "string",
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "maxLength": 200
          },
          "reports": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "Recurring revenue health",
                "Retention and churn",
                "Sales performance",
                "New customers",
                "Board pack",
                "Investor quarterly",
                "Refunds and returns",
                "Payment health",
                "Marketplace health"
              ]
            }
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "consent": {
            "const": true
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "code"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "The request was not accepted (RFC 9457)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
