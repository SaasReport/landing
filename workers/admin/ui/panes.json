{
  "$schema": "./panes.schema.json",
  "schema": "saasreport.admin-panes.v1",
  "title": "SaasReport admin",
  "intro": "Type a command, or open a tab. Every pane reads the admin API and says so; changes (lead status, retries, suppressions) are made through the API, and every one is written to the audit log.",
  "licence": "Private to the owner. Read through Cloudflare Access; nothing here may be copied out.",
  "layouts": [
    {
      "id": "users",
      "title": "User management",
      "groups": [
        [
          "users",
          "roles"
        ],
        [
          "invitations",
          "audit"
        ]
      ]
    },
    {
      "id": "finops-bizops",
      "title": "FinOps and BizOps",
      "groups": [
        [
          "finops"
        ],
        [
          "bizops",
          "funnel"
        ]
      ]
    },
    {
      "id": "platform-saas-infra",
      "title": "Platform, SaaS and Infra",
      "groups": [
        [
          "platformops",
          "saasops"
        ],
        [
          "infraops",
          "workers"
        ]
      ]
    },
    {
      "id": "inbox",
      "title": "Leads and deliveries",
      "groups": [
        [
          "leads",
          "funnel"
        ],
        [
          "deliveries",
          "deliveries-summary",
          "alerts"
        ]
      ]
    },
    {
      "id": "mail",
      "title": "Mail",
      "groups": [
        [
          "inbound",
          "autoreply"
        ],
        [
          "suppressions",
          "receipts"
        ]
      ]
    },
    {
      "id": "registries",
      "title": "Registries",
      "groups": [
        [
          "stakeholders",
          "metrics",
          "report-types"
        ],
        [
          "findings",
          "commitments",
          "legal"
        ]
      ]
    },
    {
      "id": "operations",
      "title": "Operations",
      "groups": [
        [
          "workers",
          "audit"
        ],
        [
          "provisioning-config",
          "provisioning-bindings",
          "provisioning-planned"
        ]
      ]
    }
  ],
  "defaultLayout": "finops-bizops",
  "panes": [
    {
      "id": "workers",
      "operation": "getOverview",
      "rows": "/workers",
      "title": "Workers",
      "summary": "Every Worker's /api/build: the commit it serves, and whether it is main's head.",
      "empty": "No Worker answered.",
      "command": {
        "verb": "WORKERS",
        "aliases": [
          "health",
          "builds"
        ],
        "summary": "Health and commit of every Worker",
        "args": []
      },
      "columns": [
        {
          "key": "id",
          "label": "Worker"
        },
        {
          "key": "via",
          "label": "Reached by"
        },
        {
          "key": "reachable",
          "label": "Reachable",
          "type": "bool"
        },
        {
          "key": "commit",
          "label": "Commit"
        },
        {
          "key": "matches_main",
          "label": "Is main's head",
          "type": "bool"
        },
        {
          "key": "error",
          "label": "Error"
        }
      ]
    },
    {
      "id": "funnel",
      "operation": "getOverview",
      "rows": "/leads/by_status",
      "keyed": true,
      "title": "Lead funnel",
      "summary": "Leads by status.",
      "empty": "No leads yet.",
      "command": {
        "verb": "FUNNEL",
        "aliases": [
          "pipeline"
        ],
        "summary": "Leads by status",
        "args": []
      },
      "columns": [
        {
          "key": "key",
          "label": "Status"
        },
        {
          "key": "value",
          "label": "Leads",
          "type": "number"
        }
      ]
    },
    {
      "id": "deliveries-summary",
      "operation": "getOverview",
      "rows": "/deliveries",
      "keyed": true,
      "title": "Delivery summary",
      "summary": "The counts the monitor reads over the last day.",
      "empty": "The delivery ledger is not available.",
      "command": {
        "verb": "DSUM",
        "aliases": [
          "summary"
        ],
        "summary": "Delivery counts over the last day",
        "args": []
      },
      "columns": [
        {
          "key": "key",
          "label": "Count"
        },
        {
          "key": "value",
          "label": "Value"
        }
      ]
    },
    {
      "id": "leads",
      "operation": "listLeads",
      "rows": "/items",
      "title": "Leads",
      "summary": "Newest first. Open a lead, set its status or export the list through the API (getLead, updateLead, exportLeads).",
      "empty": "No lead matches.",
      "command": {
        "verb": "LEADS",
        "aliases": [
          "lead"
        ],
        "summary": "Leads, filtered by status, form or name",
        "args": [
          {
            "param": "status",
            "hint": "new, contacted, qualified, won or lost"
          },
          {
            "param": "form",
            "hint": "a form id"
          },
          {
            "param": "q",
            "hint": "part of a name or company"
          }
        ],
        "example": "LEADS new"
      },
      "columns": [
        {
          "key": "created_at",
          "label": "Received",
          "type": "date"
        },
        {
          "key": "name",
          "label": "Name"
        },
        {
          "key": "company",
          "label": "Company"
        },
        {
          "key": "form",
          "label": "Form"
        },
        {
          "key": "status",
          "label": "Status"
        },
        {
          "key": "comms_status",
          "label": "Autoreply"
        },
        {
          "key": "id",
          "label": "Reference"
        }
      ]
    },
    {
      "id": "deliveries",
      "operation": "listDeliveries",
      "rows": "/items",
      "title": "Form deliveries",
      "summary": "The receipt and the owner's notification of every submission. A failed one is retried through the comms engine (retryDelivery).",
      "empty": "No delivery matches.",
      "command": {
        "verb": "DELIV",
        "aliases": [
          "deliveries",
          "ledger"
        ],
        "summary": "The form delivery ledger",
        "args": [
          {
            "param": "state",
            "hint": "all, failed or pending"
          },
          {
            "param": "form_id",
            "hint": "a form id"
          }
        ],
        "example": "DELIV failed"
      },
      "columns": [
        {
          "key": "created_at",
          "label": "Received",
          "type": "date"
        },
        {
          "key": "reference",
          "label": "Reference"
        },
        {
          "key": "form_id",
          "label": "Form"
        },
        {
          "key": "receipt.status",
          "label": "Receipt"
        },
        {
          "key": "owner.status",
          "label": "Owner"
        },
        {
          "key": "owner.error",
          "label": "Owner error"
        }
