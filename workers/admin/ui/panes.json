      "columns": [
        {
          "key": "at",
          "label": "When",
          "type": "date"
        },
        {
          "key": "kind",
          "label": "Kind"
        },
        {
          "key": "id",
          "label": "Reference"
        },
        {
          "key": "form_id",
          "label": "Form"
        },
        {
          "key": "status",
          "label": "Status"
        },
