{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaasReport/landing/blob/main/workers/admin/ui/panes.schema.json",
  "title": "saasreport.admin-panes.v1",
  "description": "The panes of the admin interface: which operation of contracts/admin.openapi.json each reads, which rows and columns it shows, and the command that opens it. scripts/admin-ui.mjs turns this and the contract into the workbench scenario (kit widgets build then makes the interface); a column the contract's row schema does not have is a build error.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "intro", "licence", "layouts", "defaultLayout", "panes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "saasreport.admin-panes.v1" },
    "title": { "type": "string", "minLength": 1 },
    "intro": { "type": "string", "minLength": 1 },
    "licence": { "type": "string", "minLength": 1, "description": "The licence line every pane shows." },
    "defaultLayout": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "layouts": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "title", "groups"], "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string" },
        "groups": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } } } } }
    },
    "panes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "operation", "rows", "title", "summary", "empty", "command", "columns"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "operation": { "type": "string", "pattern": "^[a-z][A-Za-z]+$", "description": "An operationId of the contract (a GET without a path parameter, or with `path` naming the concrete path)." },
          "path": { "type": "string", "pattern": "^/api/", "description": "The concrete path when the operation's path has a parameter (getRegistry)." },
          "rows": { "type": "string", "pattern": "^/", "description": "JSON pointer of the rows in the response." },
          "keyed": { "type": "boolean", "description": "The pointer names an object: each entry becomes a row { key, value }." },
          "title": { "type": "string" }, "summary": { "type": "string" }, "empty": { "type": "string" },
          "command": {
            "type": "object", "additionalProperties": false, "required": ["verb", "aliases", "summary", "args"],
            "properties": {
              "verb": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$" },
              "aliases": { "type": "array", "items": { "type": "string", "minLength": 2 } },
              "summary": { "type": "string" },
              "example": { "type": "string" },
              "args": { "type": "array", "maxItems": 6, "items": { "type": "object", "additionalProperties": false, "required": ["param"], "properties": { "param": { "type": "string", "description": "A query parameter of the operation: its type, enum and limits come from the contract." }, "hint": { "type": "string" } } } }
            }
          },
          "columns": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["key", "label"], "properties": { "key": { "type": "string", "pattern": "^[A-Za-z_][\\w.]{0,47}$" }, "label": { "type": "string" }, "type": { "enum": ["text", "number", "bool", "link", "date"] } } } }
        }
      }
    }
  }
}
