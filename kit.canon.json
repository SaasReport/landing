{
  "$schema": "https://github.com/SaasReport/kit/blob/main/packages/core/schemas/canon.schema.json",
  "project": "saasreport",
  "vendor": {
    "path": "vendor/kit",
    "include": [
      "packages",
      "templates",
      "LICENSE",
      "NOTICE"
    ]
  },
  "schemas": [
    {
      "files": [
        "content/copy.json"
      ],
      "schema": "schemas/copy.schema.json"
    },
    {
      "module": "comms.config.js",
      "schema": "comms-config"
    },
    {
      "module": "src/forms.js",
      "export": "FORMS",
      "schema": "lead-forms"
    }
  ],
  "hardcoding": {
    "paths": [
      "scripts/**"
    ],
    "allow": "canon.allow.json"
  },
  "freshness": [
    {
      "name": "the landing's generated content, scenarios and brand files (scripts/generate.mjs)",
      "command": "node scripts/generate.mjs --check",
      "outputs": [
        "content/generated/landing.en.json",
        "content/generated/chrome.en.json",
        "content/generated/scenarios.json",
        "public/brand/logo.svg",
        "public/brand/icon.svg"
      ]
    },
    {
      "name": "the generated widgets (kit widgets build)",
      "command": "node vendor/kit/packages/cli/bin/kit.js widgets build --check",
      "outputs": [
        "content/generated/widgets.generated.json"
      ]
    },
    {
      "name": "the API Worker's bundled registries and sample data (scripts/api-data.mjs)",
      "command": "node scripts/api-data.mjs --check",
      "outputs": [
        "workers/api/src/data.generated.js"
      ]
    }
  ],
  "diagrams": "docs/diagrams",
  "spelling": {
    "variant": "en-GB",
    "paths": [
      "content/copy.json",
      "docs/*.md"
    ],
    "exclude": [
      "docs/diagrams/**"
    ],
    "exceptions": "spelling.exceptions.json"
  },
  "tokens": {
    "module": "site.config.js",
    "export": "brand",
    "sources": [
      "tokens.json"
    ],
    "paths": [
      "scripts",
      "engine",
      "content",
      "site.config.js",
      "docs/diagrams/brand.config.js"
    ],
    "exclude": [
      "content/generated/**"
    ],
    "generated": [
      "dist/**/*.css",
      "dist/**/*.html"
    ]
  },
  "workflows": {
    "runner": "ubuntu-24.04",
    "canary": {
      "runner": "ubuntu-26.04",
      "review_by": "2026-11-19"
    },
    "ci": {
      "branches": [
        "main"
      ],
      "schedule_exceptions": [
        {
          "cron": "41 5 * * *",
          "reason": "the daily staleness verifier (docs/FRESHNESS.md): staleness is measured against the live remote head, so a weekly run would leave a stale branch, vendor or deploy undetected for up to six days"
        },
        {
          "cron": "41 7 * * *",
          "reason": "the daily drift check of the kit's production template (docs/RELEASE.md): every Worker must serve main's commit, and a weekly run would leave a drift undetected for up to six days"
        },
        {
          "cron": "7 */2 * * *",
          "reason": "the independent watcher of the API health (docs/RESILIENCE.md): it runs on GitHub outside the Cloudflare account, and stale_after_min is derived from this two-hour gap"
        },
        {
          "cron": "17 6 * * *",
          "reason": "the daily canary through the second alert route (docs/RESILIENCE.md): a route that is not exercised every day is not proven"
        }
      ]
    }
  },
  "notApplicable": {
    "digits": {
      "predicate": "no-persian-site"
    },
    "persian": {
      "predicate": "no-persian-content"
    }
  },
  "contracts": [
    {
      "name": "api",
      "type": "openapi",
      "contract": "contracts/api.openapi.json",
      "sources": [
        "workers/api/src/worker.js"
      ],
      "routes": "(?<![\\w.])/v1(?:/[A-Za-z0-9._{}-]+)*/?(?![\\w/])"
    }
  ],
  "resilience": {
    "file": "resilience.json"
  },
  "release": {
    "file": "release.json"
  }
}
