{
  "name": "saasreport-landing",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@saasreport/calendar": "file:vendor/kit/packages/calendar",
    "@saasreport/channels": "file:vendor/kit/packages/channels",
    "@saasreport/cli": "file:vendor/kit/packages/cli",
    "@saasreport/cloudflare": "file:vendor/kit/packages/cloudflare",
    "@saasreport/comms": "file:vendor/kit/packages/comms",
    "@saasreport/core": "file:vendor/kit/packages/core",
    "@saasreport/fa-lint": "file:vendor/kit/packages/fa-lint",
    "@saasreport/format": "file:vendor/kit/packages/format",
    "@saasreport/plugins": "file:vendor/kit/packages/plugins",
    "@saasreport/podcast": "file:vendor/kit/packages/podcast",
    "@saasreport/site": "file:vendor/kit/packages/site",
    "@saasreport/speech": "file:vendor/kit/packages/speech",
    "@saasreport/uploads": "file:vendor/kit/packages/uploads",
    "@saasreport/widgets": "file:vendor/kit/packages/widgets",
    "@saasreport/workbench": "file:vendor/kit/packages/workbench"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "mermaid": "^11.12.0",
    "playwright": "^1.63.0",
    "semver": "^7.8.5"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && node scripts/api-data.mjs && kit widgets build && kit site build && cp -r public/. dist/ && mkdir -p dist/sdk && cp -r sdk/saasreport dist/sdk/",
    "check": "node scripts/generate.mjs --check && node scripts/api-data.mjs --check && kit widgets check && kit widgets build --check && kit site check && kit diagrams check && npm run comms:check",
    "test": "kit check canon && npm run test:api && kit comms check --config comms.config.js --forms src/forms.js && npm run check && npm run build && kit site shell --out dist",
    "qa": "node test/interact.test.mjs",
    "qa:visual": "kit site visual-qa --out dist",
    "comms:check": "kit comms check --config comms.config.js --forms src/forms.js",
    "test:api": "node --test workers/api/test/*.test.mjs",
    "qa:api": "node test/api-browser.test.mjs"
  }
}
